# ============================================================
# AgentGuard — Environment Configuration Template
# ============================================================
# Copy this file to .env for local development.
# Never publish actual API keys or reviewer tokens.
# ============================================================


# ------------------------------------------------------------
# 1. LLM Provider — Optional
# ------------------------------------------------------------

GROQ_API_KEY=

GROQ_MODEL=openai/gpt-oss-120b


# ------------------------------------------------------------
# 2. Reviewer Authentication
# ------------------------------------------------------------
# Use a unique, randomly generated value of at least 32 characters.
# Set the SAME value in the backend and frontend server environments.
# Do not expose this token in browser-side JavaScript.

REVIEWER_TOKEN=


# ------------------------------------------------------------
# 3. Frontend CORS Origins
# ------------------------------------------------------------
# Local Next.js development defaults.

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ------------------------------------------------------------
# 4. Database
# ------------------------------------------------------------
# Leave unset to use the default:
# backend/agentguard_audit.db
#
# For a custom location, configure an absolute path.
# Example:
# AGENTGUARD_DB_PATH=C:/AgentGuardData/agentguard_audit.db


# ------------------------------------------------------------
# 5. Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO